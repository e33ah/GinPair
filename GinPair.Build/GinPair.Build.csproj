<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
    <UserSecretsId>fa617959-b4f2-44b4-9fae-8b99dd866812</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
    <PackageReference Include="Fallout.Utilities" Version="10.4.0" />
    <PackageReference Include="Fallout.Utilities.IO.Compression" Version="10.4.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <!--Add cryptographic packages temporarily until Fallout is updated-->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="dotnet-stryker" Version="[5.0.0]" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

</Project>
